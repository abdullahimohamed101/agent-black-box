# Template for the production .env (Phase 23). Copy to .env next to docker-compose.yml, mode 0600, outside git.
# scripts/hosting-secrets.sh generates the empty secrets below; this file holds names only, never real values.
# The development stack ignores this file; it is read by docker compose -f docker-compose.yml -f deploy/hosting/compose.production.yml.

# The public https origin of the dashboard and the API (one hostname, ADR-178). No trailing slash.
ABB_PUBLIC_ORIGIN=https://abb.example.org

# Generated before the first start (PostgreSQL stores the first one when it creates the volume).
ABB_POSTGRES_PASSWORD=
ABB_RUNTIME_DB_PASSWORD=
ABB_RETENTION_DB_PASSWORD=
# 24 or more characters; enables /metrics, which the proxy never routes.
ABB_METRICS_TOKEN=

# Sign-in (OpenID Connect). The client secret is entered by the owner in an editor, never generated or pasted into chat.
ABB_OIDC_ISSUER=https://accounts.google.com
ABB_OIDC_CLIENT_ID=
ABB_OIDC_CLIENT_SECRET=
ABB_OIDC_EXTRA_HOSTS=oauth2.googleapis.com,www.googleapis.com

# dry_run measures and reports; enforce deletes permanently. Stay on dry_run until a restore drill has been performed.
ABB_RETENTION_MODE=dry_run

# The shared Caddy project reads these (deploy/hosting/edge).
ABB_ACME_EMAIL=
