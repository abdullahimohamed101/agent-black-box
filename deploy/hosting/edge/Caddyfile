# The shared Caddy (Phase 23, ADR-178). Global options only; every app is one file in sites/.
# Values come from the container environment (deploy/hosting/edge/compose.yml): {$NAME:default}.
{
	email {$ABB_ACME_EMAIL}

	# Ports the container listens on. 80 and 443 in production; the local rig uses high numbers so no root is needed.
	http_port {$ABB_EDGE_HTTP_PORT:80}
	https_port {$ABB_EDGE_HTTPS_PORT:443}

	servers {
		# HTTP/3 stays off until UDP/443 is opened on purpose.
		protocols h1 h2
		timeouts {
			# Slow-loris bounds. There is deliberately no write timeout: a live run page holds an event stream open for
			# up to 15 minutes (ABB_STREAM_MAX_LIFETIME_SECONDS) and a write deadline would cut it.
			read_header 30s
			read_body 60s
			idle 2m
		}
	}

	# Optional extra global options (the local rig puts `local_certs` here). Empty on a real server.
	import globals/*.caddy
}

import sites/*.caddy
