# 02:30 every night, server time (UTC on a fresh Hetzner image). Persistent=true runs a missed night at the next boot.
# RandomizedDelaySec spreads load if the same provider is shared; the retention job is not scheduled near this window.
[Unit]
Description=Nightly Agent BlackBox backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=10min
Persistent=true
AccuracySec=1min
Unit=abb-backup.service

[Install]
WantedBy=timers.target
