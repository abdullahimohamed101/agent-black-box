# /etc/abb/backup.env (mode 0600, owner deploy). Names only; no secret value belongs in this file except, optionally, the
# dead-man URL. The passphrase lives in its own file and the provider key in /etc/abb/rclone.conf.
ABB_DIR=/opt/abb
ABB_BACKUP_DIR=/opt/abb/backups
ABB_BACKUP_PASSPHRASE_FILE=/etc/abb/backup.pass
# rclone remote:path of the SECOND provider. [NEEDS INPUT]: Backblaze B2 (b2:<bucket>/abb) or a Hetzner Storage Box (sftp).
ABB_OFFSITE_REMOTE=
ABB_TEXTFILE_DIR=/var/lib/node_exporter/textfile
# Retention. Local copies: 7 days but always the newest 3. Off-site: 30 days but always the newest 7 complete bundles.
ABB_LOCAL_KEEP_DAYS=7
ABB_LOCAL_KEEP_MIN=3
ABB_OFFSITE_KEEP_DAYS=30
ABB_OFFSITE_KEEP_MIN=7
# 1 prunes old off-site bundles (the key needs delete rights). 0 when the key is write/list only: set a lifecycle rule at the
# provider instead (a write-only key also limits what ransomware on this host can destroy).
ABB_OFFSITE_PRUNE=1
# Optional dead-man's switch (Healthchecks.io style URL, pinged after a successful cycle). [NEEDS INPUT]
ABB_DEADMAN_URL=
# Which compose projects scripts/hosting-container-metrics.sh reports (space separated). Empty = every container on the host, which is
# what you want when a second application shares the server.
ABB_METRICS_PROJECTS=
