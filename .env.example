# Copy to .env. Local development values only; never put real secrets here.
# development|test|production. `production` is mandatory for any reachable deployment: it switches off http issuers,
# dev sessions and the seeded local owner (docs/runbooks/auth-and-access.md).
ABB_ENVIRONMENT=development
ABB_LOG_LEVEL=INFO
# Dev database: compose service "postgres" published on host port 5433 (avoids clashing with a native Postgres on 5432).
ABB_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb
ABB_TEST_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb_test
# Production-like separation (KI-020): migrations run as the database owner (ABB_MIGRATION_DATABASE_URL, falls back to
# ABB_DATABASE_URL); the API and worker run as the `abb_runtime` role, which cannot UPDATE/DELETE events. `alembic upgrade`
# sets that role's login password from ABB_RUNTIME_DB_PASSWORD. The default dev database keeps using the owner for convenience.
# ABB_MIGRATION_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb
# ABB_RUNTIME_DB_PASSWORD=abb_runtime_dev_password
# ABB_DATABASE_URL=postgresql+asyncpg://abb_runtime:abb_runtime_dev_password@localhost:5433/abb
ABB_CORS_ORIGINS=http://localhost:3000
# Data retention (Phase 19b, ADR-159). The retention job is its own process (`python -m abb_api.retention run`, or one tick with
# `python -m abb_api.cli retention run-once`) and connects as the `abb_retention` role, the only one that may delete retained data.
# `alembic upgrade` gives that role a login from ABB_RETENTION_DB_PASSWORD. Never put this URL in the API's or worker's environment.
# Without it, development and test fall back to the owner URL; staging and production refuse to run.
# ABB_RETENTION_DB_PASSWORD=abb_retention_dev_password
# ABB_RETENTION_DATABASE_URL=postgresql+asyncpg://abb_retention:abb_retention_dev_password@localhost:5433/abb
# off | dry_run (default: measure and report, delete nothing) | enforce (deletes, permanently: back up first, ADR-160;
# the process also needs ABB_ARTIFACT_DIR to be the API's artifact directory)
# ABB_RETENTION_MODE=dry_run
# Workspace defaults, in days after a run ended (7-36500, or forever); artifacts <= trace <= run.
# ABB_RETENTION_ARTIFACTS_DAYS=30
# ABB_RETENTION_TRACE_DAYS=90
# ABB_RETENTION_RUN_DAYS=365
# ABB_RETENTION_AUDIT_DAYS=365
# Enforcement bounds: rows deleted per transaction, and attempts per run before it waits for `retry-failed`.
# ABB_RETENTION_BATCH_SIZE=2000
# ABB_RETENTION_MAX_ATTEMPTS=5
# Backup, restore and rotation (Phase 19b, ADR-162): `python -m abb_api.backup create|verify|restore`,
# `python -m abb_api.rotate alerts`. They connect as the database OWNER (they read every table); URLs and passphrases
# are never command-line arguments. create: ABB_BACKUP_DATABASE_URL, else ABB_MIGRATION_DATABASE_URL, else ABB_DATABASE_URL.
# restore: ABB_RESTORE_DATABASE_URL only (a NEW, empty database; no fallback on purpose). rotate: ABB_ROTATION_DATABASE_URL, else the same chain.
# ABB_BACKUP_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb
# ABB_RESTORE_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb_restored
# Ingestion limits (defaults shown; uncomment to override)
# ABB_INGEST_MAX_BODY_BYTES=5242880
# ABB_INGEST_MAX_BATCH_EVENTS=1000
# Artifacts (diffs, terminal output; ADR-030): local directory and per-artifact size cap.
# ABB_ARTIFACT_DIR=.artifacts
# ABB_ARTIFACT_MAX_BYTES=8388608
# Edge (Phase 19a, ADR-155): request-body bytes held in memory per API process, the interactive docs (unset: off only in production),
# and the override that lets a process run with a database role that can rewrite events (production refuses otherwise).
# ABB_MAX_BODY_BYTES_IN_FLIGHT=67108864
# ABB_API_DOCS_ENABLED=
# ABB_ALLOW_PRIVILEGED_DB_ROLE=0
# Database safety (Phase 19c, ADR-169). Default statement_timeout of API connections (seconds, 0 = none; budgeted routes override
# it), the worker's own (0 = none), the circuit breaker (kill switch: ABB_DB_BREAKER_ENABLED=0) and the periodic role re-check.
# ABB_DB_STATEMENT_TIMEOUT_SECONDS=30
# ABB_WORKER_DB_STATEMENT_TIMEOUT_SECONDS=0
# ABB_DB_BREAKER_ENABLED=1
# ABB_DB_BREAKER_THRESHOLD=5
# ABB_DB_BREAKER_OPEN_SECONDS=5
# ABB_DB_BREAKER_WINDOW_SECONDS=30
# ABB_ROLE_CHECK_INTERVAL_SECONDS=300
# Failed session cookies (ADR-169, KI-176): failures per window per trusted address (needs ABB_TRUST_PROXY=1) and globally.
# ABB_SESSION_FAIL_ENABLED=1
# ABB_SESSION_FAIL_WINDOW_SECONDS=60
# ABB_SESSION_FAIL_PER_ADDRESS=30
# ABB_SESSION_FAIL_GLOBAL=600
# Per-project quotas (Phase 19a, ADR-154): defaults for every project; an owner or admin can override each one per project.
# At a limit the excess is refused with QUOTA_EXCEEDED, what the project already has keeps working. ABB_QUOTAS_ENABLED=false turns it all off.
# ABB_QUOTAS_ENABLED=true
# ABB_QUOTA_AGENTS=500
# ABB_QUOTA_RUNS_PER_DAY=50000
# ABB_QUOTA_EVENTS_PER_DAY=5000000
# ABB_QUOTA_ARTIFACT_BYTES=5368709120
# Server-side secret scan budgets (ADR-130); beyond them the value or artifact body is dropped, never stored unscanned.
# ABB_SECURITY_SCAN_EVENT_MAX_SECONDS=1
# ABB_SECURITY_SCAN_ARTIFACT_MAX_BYTES=4194304
# ABB_SECURITY_SCAN_ARTIFACT_MAX_SECONDS=10
# A change to a project's muted detectors or destination allowlist re-analyses its newest runs (KI-133): at most N runs started within D days. At most one wave per project per C seconds (a later one is deferred, not dropped).
# ABB_SECURITY_REANALYSE_MAX_RUNS=200
# ABB_SECURITY_REANALYSE_MAX_AGE_DAYS=30
# ABB_SECURITY_REANALYSE_COOLDOWN_SECONDS=60
# ABB_RATE_LIMIT_EVENTS_PER_SECOND=2000
# ABB_RATE_LIMIT_BURST_EVENTS=10000
# Delay before a run is re-summarized after new events (bursts coalesce into one recomputation)
# ABB_SUMMARY_DEBOUNCE_SECONDS=1
# Reliability findings (ADR-080/081): wait before a run's detectors run (grows with run size, max 60 s),
# the most events analysed per run, and the detector thresholds (every finding records the ones it used).
# ABB_FINDINGS_DELAY_SECONDS=5
# At most one analysis per active run per this many seconds (a run that ended is analysed at once; 0 = off)
# ABB_FINDINGS_MIN_INTERVAL_SECONDS=10
# ABB_FINDINGS_MAX_EVENTS=50000
# ABB_FINDINGS_LOOP_MIN_REPETITIONS=3
# ABB_FINDINGS_LOOP_MIN_REPETITIONS_SINGLE=8
# ABB_FINDINGS_IDENTICAL_MIN_COUNT=3
# ABB_FINDINGS_RETRY_STORM_MIN=5
# ABB_FINDINGS_RETRY_BURST_WINDOW_SECONDS=60
# ABB_FINDINGS_CONTEXT_GROWTH_MIN_DELTA_TOKENS=4000
# ABB_FINDINGS_CONTEXT_GROWTH_FACTOR=2.0
# ABB_FINDINGS_CONTEXT_GROWTH_WARNING_TOKENS=100000
# ABB_FINDINGS_CASCADE_MIN_FAILURES=3
# ABB_FINDINGS_CASCADE_WINDOW_CALLS=10
# ABB_FINDINGS_COST_SPIKE_MIN_BASELINE=20
# ABB_FINDINGS_COST_SPIKE_WINDOW_DAYS=30
# Web app -> API (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Web app server-side API access. The web server holds no credential of its own: it forwards the visitor's session
# cookie to the API (ADR-060). The browser-visible origin below is also what the session cookie name and CSRF check derive from.
ABB_WEB_ORIGIN=http://localhost:3000
# ABB_API_INTERNAL_URL=http://localhost:8000
# ABB_TRUST_PROXY=1   # only behind a proxy that sets X-Forwarded-For and is the only way to reach the web port (runbook: auth-and-access)
# ABB_WEB_DATA_SOURCE=fixtures   # serve deterministic fixtures instead of the API (UI development, Playwright)
# Sign-in (ADR-060). OIDC is off until the issuer is set. `scripts/fake-oidc.sh` serves a DEVELOPMENT-ONLY provider on :8900
# that accepts any email; point these at a real OpenID Connect provider for anything else (https only outside development).
# ABB_OIDC_ISSUER=http://localhost:8900
# ABB_OIDC_CLIENT_ID=abb-dev
# ABB_OIDC_CLIENT_SECRET=
# Sessions: lifetimes, and how often an open live stream re-checks its credential.
# ABB_SESSION_ABSOLUTE_HOURS=168
# ABB_SESSION_IDLE_HOURS=24
# ABB_STREAM_REAUTH_SECONDS=30
# Development and test only (ignored unless ABB_ENVIRONMENT is development or test): lets `cli create-session` mint a sign-in
# session for scripts. `make seed` sets it for its own run to add the local owner owner@local.test. Never set it in a deployment.
# ABB_ALLOW_DEV_SESSIONS=1
# Ports a webhook or Slack alert destination may use (comma list, default 443). Add a port only for a receiver you operate.
# ABB_ALERTS_ALLOWED_PORTS=443
# Metrics (ADR-165). GET /metrics exists only when a token of 24+ characters is set; scrape with
# `Authorization: Bearer <token>`. Generate one with `openssl rand -hex 32`. Do not expose the endpoint publicly.
# ABB_METRICS_TOKEN=
# ABB_METRICS_REQUESTS_PER_MINUTE=120
# The worker serves the same registry on this port when set (needs the token; loopback unless the bind says otherwise).
# ABB_WORKER_METRICS_PORT=
# ABB_WORKER_METRICS_BIND=127.0.0.1
# Optional tracing (ADR-170). Needs the `otel` extra (uv sync --extra otel, or the image build arg UV_SYNC_ARGS="--extra otel").
# The collector address and headers use the standard OpenTelemetry variables; headers are secrets.
# ABB_OTEL_ENABLED=0
# ABB_OTEL_SAMPLE_RATIO=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
