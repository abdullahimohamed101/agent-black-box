# Copy to .env. Local development values only; never put real secrets here.
# development|test|production. `production` is mandatory for any reachable deployment: it switches off http issuers,
# dev sessions and the seeded local owner (docs/runbooks/auth-and-access.md).
ABB_ENVIRONMENT=development
ABB_LOG_LEVEL=INFO
# Dev database: compose service "postgres" published on host port 5433 (avoids clashing with a native Postgres on 5432).
ABB_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb
ABB_TEST_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb_test
# Production-like separation (KI-020): migrations run as the database owner (ABB_MIGRATION_DATABASE_URL, falls back to
# ABB_DATABASE_URL); the API and worker run as the `abb_runtime` role, which cannot UPDATE/DELETE events. `alembic upgrade`
# sets that role's login password from ABB_RUNTIME_DB_PASSWORD. The default dev database keeps using the owner for convenience.
# ABB_MIGRATION_DATABASE_URL=postgresql+asyncpg://abb:abb_dev_password@localhost:5433/abb
# ABB_RUNTIME_DB_PASSWORD=abb_runtime_dev_password
# ABB_DATABASE_URL=postgresql+asyncpg://abb_runtime:abb_runtime_dev_password@localhost:5433/abb
ABB_CORS_ORIGINS=http://localhost:3000
# Ingestion limits (defaults shown; uncomment to override)
# ABB_INGEST_MAX_BODY_BYTES=5242880
# ABB_INGEST_MAX_BATCH_EVENTS=1000
# Artifacts (diffs, terminal output; ADR-030): local directory and per-artifact size cap.
# ABB_ARTIFACT_DIR=.artifacts
# ABB_ARTIFACT_MAX_BYTES=8388608
# Server-side secret scan budgets (ADR-130); beyond them the value or artifact body is dropped, never stored unscanned.
# ABB_SECURITY_SCAN_EVENT_MAX_SECONDS=1
# ABB_SECURITY_SCAN_ARTIFACT_MAX_BYTES=4194304
# ABB_SECURITY_SCAN_ARTIFACT_MAX_SECONDS=10
# A change to a project's muted detectors or destination allowlist re-analyses its newest runs (KI-133): at most N runs started within D days. At most one wave per project per C seconds (a later one is deferred, not dropped).
# ABB_SECURITY_REANALYSE_MAX_RUNS=200
# ABB_SECURITY_REANALYSE_MAX_AGE_DAYS=30
# ABB_SECURITY_REANALYSE_COOLDOWN_SECONDS=60
# ABB_RATE_LIMIT_EVENTS_PER_SECOND=2000
# ABB_RATE_LIMIT_BURST_EVENTS=10000
# Delay before a run is re-summarized after new events (bursts coalesce into one recomputation)
# ABB_SUMMARY_DEBOUNCE_SECONDS=1
# Reliability findings (ADR-080/081): wait before a run's detectors run (grows with run size, max 60 s),
# the most events analysed per run, and the detector thresholds (every finding records the ones it used).
# ABB_FINDINGS_DELAY_SECONDS=5
# ABB_FINDINGS_MAX_EVENTS=50000
# ABB_FINDINGS_LOOP_MIN_REPETITIONS=3
# ABB_FINDINGS_LOOP_MIN_REPETITIONS_SINGLE=8
# ABB_FINDINGS_IDENTICAL_MIN_COUNT=3
# ABB_FINDINGS_RETRY_STORM_MIN=5
# ABB_FINDINGS_RETRY_BURST_WINDOW_SECONDS=60
# ABB_FINDINGS_CONTEXT_GROWTH_MIN_DELTA_TOKENS=4000
# ABB_FINDINGS_CONTEXT_GROWTH_FACTOR=2.0
# ABB_FINDINGS_CONTEXT_GROWTH_WARNING_TOKENS=100000
# ABB_FINDINGS_CASCADE_MIN_FAILURES=3
# ABB_FINDINGS_CASCADE_WINDOW_CALLS=10
# ABB_FINDINGS_COST_SPIKE_MIN_BASELINE=20
# ABB_FINDINGS_COST_SPIKE_WINDOW_DAYS=30
# Web app -> API (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Web app server-side API access. The web server holds no credential of its own: it forwards the visitor's session
# cookie to the API (ADR-060). The browser-visible origin below is also what the session cookie name and CSRF check derive from.
ABB_WEB_ORIGIN=http://localhost:3000
# ABB_API_INTERNAL_URL=http://localhost:8000
# ABB_TRUST_PROXY=1   # only behind a proxy that sets X-Forwarded-For and is the only way to reach the web port (runbook: auth-and-access)
# ABB_WEB_DATA_SOURCE=fixtures   # serve deterministic fixtures instead of the API (UI development, Playwright)
# Sign-in (ADR-060). OIDC is off until the issuer is set. `scripts/fake-oidc.sh` serves a DEVELOPMENT-ONLY provider on :8900
# that accepts any email; point these at a real OpenID Connect provider for anything else (https only outside development).
# ABB_OIDC_ISSUER=http://localhost:8900
# ABB_OIDC_CLIENT_ID=abb-dev
# ABB_OIDC_CLIENT_SECRET=
# Sessions: lifetimes, and how often an open live stream re-checks its credential.
# ABB_SESSION_ABSOLUTE_HOURS=168
# ABB_SESSION_IDLE_HOURS=24
# ABB_STREAM_REAUTH_SECONDS=30
# Development and test only (ignored unless ABB_ENVIRONMENT is development or test): lets `cli create-session` mint a sign-in
# session for scripts. `make seed` sets it for its own run to add the local owner owner@local.test. Never set it in a deployment.
# ABB_ALLOW_DEV_SESSIONS=1
