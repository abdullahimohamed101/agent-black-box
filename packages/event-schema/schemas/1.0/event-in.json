      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
      },
      "type": "object"
    },
    "duration_ms": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "event_id": {
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
      "title": "Event Type",
      "type": "string"
    },
